\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Per subject sample collection.} Depending on device recovery, number of bowel movements, and CapScan sampling efficiency, subjects generated 23–-40 samples. To calculate the average number of regions per device, divide the "Regions" value by the "Devices" value.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{SamplesCollected}{{3}{3}{\textbf {Per subject sample collection.} Depending on device recovery, number of bowel movements, and CapScan sampling efficiency, subjects generated 23–-40 samples. To calculate the average number of regions per device, divide the "Regions" value by the "Devices" value}{figure.caption.4}{}}
\newlabel{fig:capsule_classification}{{4A}{3}{\relax }{figure.caption.5}{}}
