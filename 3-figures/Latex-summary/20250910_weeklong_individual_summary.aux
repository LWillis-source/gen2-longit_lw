\@writefile{toc}{\contentsline {section}{\numberline {2}General data}{7}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Sample collection}{7}{subsection.2.1}\protected@file@percent }
