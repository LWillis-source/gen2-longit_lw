\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Per subject sample collection.} Depending on device recovery, number of bowel movements, and CapScan sampling efficiency, subjects generated 23–40 samples. To calculate the average number of regions per device, divide the "Regions" value by the "Devices" value.}}{7}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Regions per device.} (A) Visual classification of capsule contents. \emph  {``SI-light"} samples were translucent, often pink or green with food particles. \emph  {``SI"} samples were typically golden and not overly chunky; a subset appeared red. \emph  {``SI-dark"} samples were dark but still liquid. \emph  {``Ascending colon (AC)"} samples were sludgy and required squeegeeing from devices. (B) Distribution of regions per device across all samples (mean 2.18 regions per device).}}{7}{figure.caption.8}\protected@file@percent }
