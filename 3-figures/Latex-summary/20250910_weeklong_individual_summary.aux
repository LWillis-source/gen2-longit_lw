\newlabel{sub@fig:capsule_regions}{{B}{3}{\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Regions per device.} (A) Visual classification of capsule contents. \emph  {``SI-light"} samples were translucent, often pink or green with food particles. \emph  {``SI"} samples were typically golden and not too chunky; a subset appeared red. \emph  {``SI-dark"} samples were dark but still liquid. \emph  {``Ascending colon (AC)"} samples were sludgy and required squeegeeing from devices. (B) Distribution of regions per device across all samples (mean 2.18 regions per device).}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{Capsule_regions}{{4}{3}{\textbf {Regions per device.} (A) Visual classification of capsule contents. \emph {``SI-light"} samples were translucent, often pink or green with food particles. \emph {``SI"} samples were typically golden and not too chunky; a subset appeared red. \emph {``SI-dark"} samples were dark but still liquid. \emph {``Ascending colon (AC)"} samples were sludgy and required squeegeeing from devices. (B) Distribution of regions per device across all samples (mean 2.18 regions per device)}{figure.caption.5}{}}
